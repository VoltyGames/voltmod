{#- The menu PanoramaMenuLayout draws, inside a screen that extends screen.xml.j2. The call body
    becomes the sidebar brand, and the optional `home` markup replaces the rows on the root menu:

    {% block content %}
    {% call blocks.menu(6, 8, ICONS) %}<Label class="menu__brand-title" text="{s:brand}" />{% endcall %}
    {% endblock %}

    Each row, its button and its steppers have their own id, so C++ can hide the row and tell
    presses and steps apart. The switch, chevron and steppers start hidden; row classes show them. -#}
{% import "button.xml.j2" as controls %}
{% import "icons.xml.j2" as icon_block %}
{% import "pager.xml.j2" as pagers %}
{% macro menu(tabs, rows, icons, home="") -%}
<Panel class="menu window{{ ' menu--with-home' if home }}">

  <Panel class="menu__sidebar">
    <Panel class="menu__brand">
      {{ caller() | indent(6) }}
    </Panel>
    <Panel class="menu__nav">
      {%- for index in range(tabs) %}
      <Button id="{{screen}}_tab{{index}}" class="tab hidden">
        {{ icon_block.icons("tab" ~ index ~ "_icon", icons) | indent(8) }}
        <Label class="tab__label" text="{s:tab{{index}}}" />
      </Button>
      {%- endfor %}
    </Panel>
  </Panel>

  <Panel class="menu__content">
    <Panel class="menu__header">
      <Panel class="menu__header-text">
        <Label class="menu__breadcrumb" text="{s:breadcrumb}" />
        <Label class="menu__title" text="{s:title}" />
        <Label id="{{screen}}_subtitle" class="menu__subtitle" text="{s:subtitle}" />
      </Panel>
      <Button id="{{screen}}_close" class="icon-button">
        <Image class="icon-button__image" src="s2r://panorama/images/icons/ui/cancel.vsvg" />
      </Button>
    </Panel>

    {%- if home %}
    <Panel class="menu__home">
      {{ home | indent(6) }}
    </Panel>
    {%- endif %}

    <Panel class="menu__rows">
      {%- for row in range(rows) %}
      <Panel id="{{screen}}_row{{row}}" class="row hidden">
        <Button id="{{screen}}_row{{row}}_button" class="row__button">
          <Panel class="row__body">
            <Label class="row__label" text="{s:row{{row}}_label}" />
            <Label class="row__hint" text="{s:row{{row}}_hint}" />
          </Panel>
          <Label class="row__value" text="{s:row{{row}}_value}" />
          <Panel class="switch">
            <Panel class="switch__knob" />
          </Panel>
          <Label class="row__chevron" text="&#8250;" />
        </Button>
        <Panel class="row__steppers">
          <Button id="{{screen}}_row{{row}}_decrease" class="row__stepper">
            <Label class="row__stepper-glyph" text="&#9664;" />
          </Button>
          <Button id="{{screen}}_row{{row}}_increase" class="row__stepper">
            <Label class="row__stepper-glyph" text="&#9654;" />
          </Button>
        </Panel>
      </Panel>
      {%- endfor %}
      <Label id="{{screen}}_empty" class="menu__empty hidden" text="{s:empty}" />
    </Panel>

    <Panel id="{{screen}}_prompt" class="menu__prompt hidden">
      <Label class="menu__prompt-text" text="{s:prompt_text}" />
      <Label class="menu__prompt-hint" text="{s:prompt_hint}" />
      {{ controls.button("cancel", "{s:cancel}") | indent(6) }}
    </Panel>

    <Panel class="menu__footer">
      {{ controls.button("back", "{s:back}") | indent(6) }}
      {{ pagers.pager("page") | indent(6) }}
    </Panel>
  </Panel>

</Panel>
{%- endmacro %}
