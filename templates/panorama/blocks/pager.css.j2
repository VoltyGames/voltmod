/* Only as wide as its parts, so the arrows stay beside the label. */
.pager {
  width: fit-children;
  flow-children: right;
}

.pager__arrow {
  width: 36px;
  height: 100%;
  font-size: 11px;
  border-radius: radius;
  background-color: bg-subtle;
  border: 1px solid border-strong;
  color: text-muted;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.pager__arrow:hover {
  background-color: bg-accent-selected;
  border: 1px solid border-accent-strong;
  color: text-default;
}

.pager__arrow:active {
  pre-transform-scale2d: 0.94;
}

/* A Label inside a Button sits in the top-left corner unless you align it. */
.pager__glyph {
  font-size: 11px;
  horizontal-align: center;
  vertical-align: center;
}

/* Fixed, so the arrows don't shift when the page count gains a digit. */
.pager__label {
  width: 80px;
  vertical-align: center;
  text-align: center;
  font-size: 14px;
  color: text-muted;
}
