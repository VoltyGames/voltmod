{#- Every screen's stylesheet includes this once, first: the theme, the root panel's size, the
    `hidden` class Screen::SetHidden puts on any element, and the `overline` text style. -#}
{% include "theme.css.j2" %}

.layer,
.screen {
  width: 100%;
  height: 100%;
}

.hidden {
  visibility: collapse;
}

.overline {
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}
