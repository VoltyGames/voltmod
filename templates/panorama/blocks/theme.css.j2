{#- The default palette as `@define` tokens, named for their role; screen.css.j2 includes it. A
    define only works in the stylesheet that declares it, so it comes in once per screen. To restyle
    a plugin's screens, put a theme.css.j2 defining the same names in its panorama/screens/. -#}
/* Brand and status colours. */
@define accent: #e1273c;
@define accent-bright: #ff4a5c;
@define highlight: #e0a040;
@define success: #4cc26a;

/* Backgrounds: windows, cards, HUD overlays, then tints that mark state. */
@define bg-window-top: #12121a;
@define bg-window: #0b0b0f;
@define bg-card-top: #101015;
@define bg-sidebar: #0a0a0e;
@define bg-overlay-top: rgba(20, 20, 28, 0.86);
@define bg-overlay: rgba(11, 11, 15, 0.82);
@define bg-overlay-accent: rgba(51, 23, 33, 0.9);
@define bg-overlay-success: rgba(28, 46, 40, 0.9);
@define bg-subtle: rgba(240, 221, 180, 0.03);
@define bg-muted: rgba(240, 221, 180, 0.05);
@define bg-accent-hover: rgba(225, 39, 60, 0.08);
@define bg-accent-selected: rgba(225, 39, 60, 0.12);
@define bg-accent-active: rgba(225, 39, 60, 0.14);
@define bg-highlight: rgba(224, 160, 64, 0.1);
@define bg-success: rgba(76, 194, 106, 0.1);
@define bg-key: #e8e4dc;
@define clear: rgba(0, 0, 0, 0);

/* Borders. */
@define border-subtle: rgba(240, 221, 180, 0.04);
@define border-default: rgba(240, 221, 180, 0.09);
@define border-strong: rgba(240, 221, 180, 0.14);
@define border-accent: rgba(225, 39, 60, 0.3);
@define border-accent-strong: rgba(225, 39, 60, 0.4);
@define border-success: rgba(76, 194, 106, 0.35);

/* Text. */
@define text-default: #f7f4ee;
@define text-muted: #9a9aa4;
@define text-disabled: #5e5e68;
@define text-on-accent: #ffffff;
@define text-key: #15151c;

/* The corner of every window, card and button. */
@define radius: 8px;

/* Shadows and glows. */
@define shadow: rgba(0, 0, 0, 0.72);
@define shadow-key: rgba(0, 0, 0, 0.5);
@define glow-accent: rgba(225, 39, 60, 0.12);
